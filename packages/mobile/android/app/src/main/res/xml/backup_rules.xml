<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower (android:fullBackupContent). Client tokens are
     encrypted with an Android Keystore key that is never backed up, so the
     ciphertext is useless after a restore and is excluded. -->
<full-backup-content>
    <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
</full-backup-content>
