<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules). See backup_rules.xml: the
     Keystore-encrypted token store cannot be decrypted after a restore or
     device transfer, so it is excluded from both. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
