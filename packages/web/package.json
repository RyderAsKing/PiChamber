{
  "name": "@pi-chamber/web",
  "version": "1.0.5",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyderAsKing/PiChamber.git"
  },
  "main": "./server/index.js",
  "types": "./server/index.d.ts",
  "bin": {
    "pichamber": "./bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run build:watch",
    "dev:server": "cross-env PICHAMBER_SERVER_PROFILE_KIND=dev bun ./bin/dev-server.js --port ${PICHAMBER_PORT:-3001}",
    "dev:server:watch": "nodemon --watch server --ext js --exec \"cross-env PICHAMBER_SERVER_PROFILE_KIND=dev bun ./bin/dev-server.js --port ${PICHAMBER_PORT:-3001}\"",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" --config ../../eslint.config.js",
    "test": "vitest run",
    "test:runtime": "vitest run server/lib/pi/session-daemon/pi-runtime-smoke.test.js",
    "start": "node bin/cli.js serve"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@octokit/rest": "^22.0.1",
    "@simplewebauthn/server": "13.3.1",
    "adm-zip": "^0.6.1",
    "bun-pty": "0.4.8",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "http-proxy-middleware": "^3.0.10",
    "jose": "^6.2.14",
    "jsonc-parser": "^3.3.1",
    "node-pty": "1.2.0-beta.12",
    "openai": "^4.104.0",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "sherpa-onnx-node": "1.12.28",
    "simple-git": "^3.36.0",
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@eslint/js": "^9.39.5",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@remixicon/react": "^4.9.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.5",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "next-themes": "^0.4.6",
    "nodemon": "^3.1.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "strip-json-comments": "^5.0.3",
    "tailwind-merge": "^3.7.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.16"
  },
  "files": [
    "dist",
    "server",
    "bin",
    "public",
    "package.json",
    "README.md"
  ]
}
