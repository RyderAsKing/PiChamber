{
  "extends": "default",
  "meta": { "name": "pichamber" },
  "groups": {
    "include": [
      "node_runtime",
      "rust_runtime",
      "python_runtime",
      "nix_runtime",
      "git_config",
      { "name": "user_caches_linux", "when": "linux" },
      { "name": "linux_sysfs_read", "when": "linux" }
    ],
    "exclude": ["system_write_linux"]
  },
  "security": { "signal_mode": "isolated", "capability_elevation": false },
  "linux": { "af_unix_mediation": "pathname" },
  "workdir": { "access": "none" },
  "filesystem": {
    "allow_file": ["/dev/null", "/dev/zero", "/dev/full", "/dev/tty"],
    "allow": ["/dev/pts", "/proc/self/fd", "/dev/fd"]
  }
}
