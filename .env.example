# Required. Docker binds 0.0.0.0, so UI authentication is mandatory.
PICHAMBER_UI_PASSWORD=

# Image tag for ghcr.io/ryderasking/pichamber. Use an exact version in production.
# PICHAMBER_VERSION=1.0.1

# Optional host-side isolation for additional Compose projects.
# PICHAMBER_HOST_PORT=3001
# PICHAMBER_DATA_DIR=./data-1
# PICHAMBER_BIND_ADDRESS=127.0.0.1
